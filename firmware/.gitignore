# STM32CubeIDE build output directories
/Debug/
/Release/

# Firmware binaries / linker outputs
*.elf
*.bin
*.hex
*.map
*.list

# Compiler intermediate files
*.o
*.d
*.su
*.cyclo

# macOS metadata
.DS_Store

# make build output (app + bootloader)
/build/
/bootloader/build/
__pycache__/

# vendor docs (charger protocol zip, GBK filenames)
*.zip

# Rust workspace (rust/): build output lives in target.nosync/ to stay out of iCloud sync
rust/target/
rust/target.nosync/

# Rust port build output (kept out of iCloud sync by the .nosync suffix)
/rust/target.nosync/
