# Stable device names for the mower (installed by deploy/install.sh as
# /etc/udev/rules.d/99-mower.rules; the repo-root usb.rules links here).
# deploy/docker-compose.yaml passes these names into the container.

# WIT IMU on a CH340 USB-serial adapter
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE:="0666", SYMLINK+="imu_usb"

# STM32 host UART.
#  - LubanCat 2: on-board UART3 (dtoverlay rk356x-lubancat-uart3-m1, see firmware/BOOTLOADER.md)
KERNEL=="ttyS3", MODE:="0666", SYMLINK+="stmcom"
#  - bench: CP2102 USB-serial adapter
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0666", SYMLINK+="stmcom"

# u-blox ZED-F9P/F9R RTK receiver (CDC-ACM)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", SYMLINK+="gps_rtk", MODE="0666", GROUP="plugdev"

# PlayStation joystick
SUBSYSTEM=="input", KERNEL=="js[0-9]*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", GROUP="joystick", MODE="0660"

# Quectel EC25 LTE modem: interface 2 is the AT command port (0 DM, 1 NMEA,
# 3 PPP). Polled by host/mower-link-status.py for signal strength.
# ATTRS{} keys in one rule must all match the same parent; idVendor lives on
# the USB device and bInterfaceNumber on the interface, so the pair never
# matched and /dev/lte_at was never created. ID_USB_INTERFACE_NUM is set on
# the tty itself by 60-serial.rules.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0125", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="lte_at", MODE="0660", GROUP="dialout"

# Genesys Logic 4-port hub the IMU / camera hang off. The kernel default
# power/control=auto lets it runtime-suspend the moment its ports are idle
# (autosuspend_delay 0 ms on this kernel); the hub dropped off the bus 77
# times on 2026-09-19, taking every sensor with it, so keep it awake. This
# is the cheap experiment, not a proven cause.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05e3", ATTR{idProduct}=="0610", TEST=="power/control", ATTR{power/control}="on"
