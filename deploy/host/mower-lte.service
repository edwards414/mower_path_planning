# Dials the LTE modem (QMI: Quectel EC25 / SIMCom SIM7600) and keeps wwan0 up as a fallback uplink at
# route metric 200; the app relay (mower_agent) and Tailscale then work over
# 4G when Ethernet / Wi-Fi are gone. APN and metric come from /opt/mower/.env.
[Unit]
Description=Mower LTE uplink (QMI modem: EC25 / SIM7600)
After=network.target
Wants=network.target

[Service]
EnvironmentFile=-/opt/mower/.env
ExecStart=/opt/mower/host/mower-lte.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
