.git
.github
.claude
.vscode

# Never send local credentials to the Docker daemon or a remote BuildKit
# builder, even when the Dockerfile does not COPY them into the final image.
.env
**/*.env
.secrets/
**/.secrets/
**/setting.local.sh
deploy/server/cloudflared-config.yml
deploy/server/tunnel-credentials.json
**/*.pem
**/*.key
**/id_rsa
**/id_ed25519

build/
install/
log/
logs/
workspace/
zone_record/

# STM32 firmware: sources are needed (built in the `firmware` stage), local
# build output is not
firmware/build/
firmware/bootloader/build/
firmware/Debug/
firmware/Release/
firmware/tools/s3_uart_bridge/.pio/
firmware/.settings/

# Packages excluded from the production image (sim / GUI / visualization only)
src/mower_sim/
src/mower_qt/
src/turtlebot3_mapviz/

# Rust build output (rebuilt inside the image; large and host-specific)
**/target/

**/__pycache__/
**/.pytest_cache/
**/pytest-cache-files-*/
**/*.pyc
**/*.pyo

**/.venv/
**/venv/
**/env/

*.tmp
*.log
