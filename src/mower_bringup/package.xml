<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mower_bringup</name>
  <version>0.0.0</version>
  <description>Mower bringup: top-level launch files for real robot, RViz, twist_mux, and sim+nav2 integration</description>
  <maintainer email="edwards940428@gmail.com">fxrbindi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>mower_nav2</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend condition="$MOWER_BUILD_TARGET != 'sim'">mower_controller</exec_depend>
  <exec_depend>mower_description</exec_depend>
  <exec_depend>mower_teleop</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>wit_ros2_imu</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>mower_mission</exec_depend>
  <exec_depend>mower_rs</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosapi</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
