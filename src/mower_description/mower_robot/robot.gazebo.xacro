<?xml version="1.0" ?>
<!-- Gazebo Harmonic (gz-sim 8.x) Sensor & Plugin 定義 -->
<!-- 對應 ROS2 Jazzy + Gazebo Harmonic 環境                 -->
<robot name="mower_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!--  Gazebo 材質顏色                                              -->
  <!-- ============================================================ -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="caster_yaw_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <gazebo reference="caster_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- ============================================================ -->
  <!--  1. gz_ros2_control Plugin                                   -->
  <!--     取代舊的 diff_drive + joint_state_publisher plugins       -->
  <!--     由 ros2_control 的 diff_drive_controller 負責:            -->
  <!--       訂閱: /diff_drive_controller/cmd_vel (remapped /cmd_vel)-->
  <!--       發布: /diff_drive_controller/odom   (remapped /odom)   -->
  <!--             /tf (odom → base_footprint)                      -->
  <!--             /joint_states (via joint_state_broadcaster)       -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <!-- 指向 controller_manager 參數檔，定義 diff_drive_controller 等 -->
      <parameters>$(find mower_description)/config/controllers.yaml</parameters>
      <!-- ↓ 在 controller_manager 層級做 remap（spawner 的 remappings= 無效！
           因為 controller 是跑在 controller_manager 進程裡，不在 spawner 進程裡）-->
      <ros>
        <remapping>/diff_drive_controller/cmd_vel:=/cmd_vel</remapping>
        <remapping>/diff_drive_controller/odom:=/odom</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- ============================================================ -->
  <!--  ros2_control Hardware Interface（Gazebo 模擬用）            -->
  <!--  使用 GazeboSimSystem plugin，讓 gz_ros2_control 與 Gazebo 溝通
  <!-- ============================================================ -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- 左輪：velocity command + position/velocity state -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-6</param>
        <param name="max">6</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 右輪：velocity command + position/velocity state -->
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-6</param>
        <param name="max">6</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 割草刀盤：effort command + effort state only -->
    <joint name="mower_joint">
      <command_interface name="effort">
        <param name="min">-100</param>
        <param name="max">100</param>
      </command_interface>
      <state_interface name="effort"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>


  <!-- ============================================================ -->
  <!--  3. IMU Sensor（掛載在 imu_link 上）                         -->
  <!--     發布: /imu/data                                          -->
  <!-- ============================================================ -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!--  4. GPS / NavSat Sensor（掛載在 gps_link 上）                -->
  <!--     發布: /gps/fix (sensor_msgs/NavSatFix)                   -->
  <!-- ============================================================ -->
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.5</stddev>   <!-- 水平精度 0.5m -->
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.8</stddev>   <!-- 垂直精度 0.8m -->
            </noise>
          </vertical>
        </position_sensing>
        <velocity_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.1</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.1</stddev>
            </noise>
          </vertical>
        </velocity_sensing>
      </navsat>
    </sensor>
  </gazebo>


</robot>
