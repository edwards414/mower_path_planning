# Copy to a gitignored location (e.g. repo-root .env) and fill in.
# The bag module's bag_store and mower-bag / mower_bag read these for Cloudflare R2.
R2_ACCOUNT_ID=your_account_id
R2_BUCKET=your_bucket
R2_PREFIX=bags
# Bucket-scoped R2 API Token (Object Read & Write):
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
