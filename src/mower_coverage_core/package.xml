<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mower_coverage_core</name>
  <version>0.1.0</version>
  <description>Rust coverage path planning core (PyO3 extension) for autonomous lawn mower</description>
  <maintainer email="edwards940428@gmail.com">fxrbindi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <!-- python3 itself comes with ros-core; the rosdep key would add python3-dev -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
