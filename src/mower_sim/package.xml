<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mower_sim</name>
  <version>0.0.0</version>
  <description>Mower simulation: Gazebo worlds, URDF assets, and sim-only launch files</description>
  <maintainer email="edwards940428@gmail.com">fxrbindi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>mower_description</exec_depend>
  <!-- NOTE: do NOT exec_depend on mower_bringup here. mower_bringup already
       exec_depends on mower_sim, and a two-way dependency makes colcon abort
       with a topological-ordering error. sim.launch.py still includes
       mower_bringup/launch/rviz.launch.py at runtime; that resolves fine in a
       from-source workspace where all packages are installed together. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
