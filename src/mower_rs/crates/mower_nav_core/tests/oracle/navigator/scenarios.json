{
  "comment": "NavigateToPose scenarios run twice: by scenarios.py against the real nav2 bt_navigator + planner_server + controller_server (+ behavior_server for the default tree) on the wall clock, and by tests/navigator_oracle.rs against mower_nav_core's NavStack on a simulated clock. Times in seconds from the scenario start; poses [x, y, yaw] in map; robot 'kinematic' follows the last cmd_vel, 'static' never moves; goals are numbered in send order. 'global' and 'local' name the maps on /map_grid_global and /map_grid. Each scenario runs once per tree in 'trees': 'clearing' is navigate_to_pose_w_replanning_and_clearing.xml (the port's tree), 'default' nav2's own; 'compare' lists the trees the port must match.",
  "map_from_odom": [0.3, -0.2, 0.1],
  "maps": {
    "empty": {"width": 120, "height": 80, "resolution": 0.05, "origin": [-2.0, -2.0]},
    "wall": {"width": 120, "height": 80, "resolution": 0.05, "origin": [-2.0, -2.0], "lethal_x": [1.2, 1.4]},
    "ring": {"width": 120, "height": 80, "resolution": 0.05, "origin": [-2.0, -2.0], "ring": [2.5, 0.0, 0.3, 0.45]}
  },
  "scenarios": [
    {
      "name": "reach",
      "global": "empty", "local": "empty", "robot": "kinematic", "start": [0.0, 0.05, 0.05], "duration": 20.0,
      "trees": ["clearing", "default"], "compare": ["clearing", "default"],
      "events": [{"t": 0.2, "op": "send", "pose": [2.0, 0.6, 0.0]}]
    },
    {
      "name": "reach_behind",
      "global": "empty", "local": "empty", "robot": "kinematic", "start": [0.0, 0.0, 3.0], "duration": 20.0,
      "trees": ["clearing"], "compare": ["clearing"],
      "events": [{"t": 0.2, "op": "send", "pose": [1.2, -0.3, 0.0]}]
    },
    {
      "name": "already_there",
      "global": "empty", "local": "empty", "robot": "static", "start": [1.0, 0.02, 0.3], "duration": 3.0,
      "trees": ["clearing"], "compare": ["clearing"],
      "events": [{"t": 0.2, "op": "send", "pose": [1.0, 0.02, 0.0]}]
    },
    {
      "name": "cancel",
      "global": "empty", "local": "empty", "robot": "kinematic", "start": [0.0, 0.05, 0.05], "duration": 4.0,
      "trees": ["clearing", "default"], "compare": ["clearing", "default"],
      "events": [
        {"t": 0.2, "op": "send", "pose": [3.0, 0.0, 0.0]},
        {"t": 3.0, "op": "cancel", "goal": 0}
      ]
    },
    {
      "name": "preempt",
      "global": "empty", "local": "empty", "robot": "kinematic", "start": [0.0, 0.05, 0.05], "duration": 16.0,
      "trees": ["clearing", "default"], "compare": ["clearing", "default"],
      "events": [
        {"t": 0.2, "op": "send", "pose": [3.0, 0.0, 0.0]},
        {"t": 2.5, "op": "send", "pose": [1.0, 0.8, 0.0]}
      ]
    },
    {
      "name": "goal_occupied",
      "global": "wall", "local": "wall", "robot": "static", "start": [0.0, 0.05, 0.05], "duration": 2.0,
      "trees": ["clearing", "default"], "compare": ["clearing", "default"],
      "events": [{"t": 0.2, "op": "send", "pose": [1.3, 0.0, 0.0]}]
    },
    {
      "name": "start_outside_map",
      "global": "empty", "local": "empty", "robot": "static", "start": [-2.5, 0.0, 0.0], "duration": 2.0,
      "trees": ["clearing"], "compare": ["clearing"],
      "events": [{"t": 0.2, "op": "send", "pose": [1.0, 0.0, 0.0]}]
    },
    {
      "name": "unreachable",
      "global": "ring", "local": "empty", "robot": "kinematic", "start": [0.0, 0.05, 0.05], "duration": 30.0,
      "trees": ["clearing", "default"], "compare": ["clearing"],
      "events": [{"t": 0.2, "op": "send", "pose": [2.5, 0.0, 0.0]}]
    },
    {
      "name": "wall_only_in_local_costmap",
      "global": "empty", "local": "wall", "robot": "kinematic", "start": [0.0, 0.05, 0.05], "duration": 75.0,
      "trees": ["clearing", "default"], "compare": ["clearing"],
      "events": [{"t": 0.2, "op": "send", "pose": [2.5, 0.0, 0.0]}]
    }
  ]
}
