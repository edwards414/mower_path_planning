<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mower_nav2</name>
  <version>0.0.0</version>
  <description>Mower Nav2 stack: navigation, localization, GPS waypoint follower, and Nav2 params</description>
  <maintainer email="edwards940428@gmail.com">fxrbindi</maintainer>
  <license>Apache-2.0</license>

  <!-- The servers and plugins navigation.launch.py / nav2_no_map_params.yaml
       actually use. Not nav2_bringup: on Jazzy it exec-depends on the
       TurtleBot simulation packages, which pull Gazebo, DART, VTK and Mesa
       (about 500 extra debs, ~2.5 GB) into the robot image. -->
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_rotation_shim_controller</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>opennav_docking</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>mower_mission</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
