<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mower_nav2</name>
  <version>0.0.0</version>
  <description>Mower Nav2 stack: navigation, localization, GPS waypoint follower, and Nav2 params</description>
  <maintainer email="edwards940428@gmail.com">fxrbindi</maintainer>
  <license>Apache-2.0</license>

  <depend>nav2_bringup</depend>
  <exec_depend>opennav_docking</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>mower_mission</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
