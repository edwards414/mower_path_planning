<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include from your robot's URDF:
         <xacro:include filename="$(find mower_hardware)/urdf/mower_base.ros2_control.xacro"/>
         <xacro:mower_base_ros2_control device="/dev/ttyS3"/>
       Joint names must match diff_drive_controller's left/right_wheel_names. -->
  <xacro:macro name="mower_base_ros2_control"
               params="name:=MowerBase device:=/dev/ttyS3 baud:=115200
                       max_rpm:=58.0 counts_per_rev:=8896
                       left_joint:=left_wheel_joint right_joint:=right_wheel_joint">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mower_hardware/MowerSystem</plugin>
        <param name="device">${device}</param>
        <param name="baud">${baud}</param>
        <!-- firmware: 1000 permille == wheel_max_rpm (default 58) -->
        <param name="max_rpm">${max_rpm}</param>
        <!-- FT-555 16 PPR x4 (quadrature) x 139:1 gearbox -->
        <param name="counts_per_rev">${counts_per_rev}</param>
        <!-- sent in every 0x01 frame; firmware stops if no command within this -->
        <param name="command_timeout_ms">300</param>
        <!-- plugin zeroes reported velocity if no 0x85 within this -->
        <param name="feedback_timeout_s">0.5</param>
      </hardware>

      <joint name="${left_joint}">
        <command_interface name="velocity">
          <param name="min">-6.1</param>
          <param name="max">6.1</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${right_joint}">
        <command_interface name="velocity">
          <param name="min">-6.1</param>
          <param name="max">6.1</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
